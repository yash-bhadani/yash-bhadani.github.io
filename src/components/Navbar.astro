---
import { personalInfo } from '../data/portfolioData';

const pathname = Astro.url.pathname;
// Normalize pathname (remove trailing slash except for root)
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, "");

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Skills', href: '/skills' },
  { name: 'Projects', href: '/projects' },
  { name: 'Contact', href: '/contact' }
];

const hireMeMailto = `mailto:${personalInfo.emails.primary}?subject=Hiring Inquiry – Portfolio&body=Hello ${personalInfo.firstName},%0D%0A%0D%0AI came across your portfolio and would like to discuss an opportunity with you.%0D%0A%0D%0ALooking forward to hearing from you.%0D%0ABest Regards,`;
---

<nav 
  id="main-navbar"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent py-6"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex justify-between items-center">
    
    <!-- Left Side: Logo/Name -->
    <div class="flex items-center">
      <a href="/" class="text-white text-2xl font-black tracking-tight whitespace-nowrap">
        {personalInfo.brandName}<span class="text-[#ff2a2a]">.</span>
      </a>
    </div>

    <!-- Center: Desktop Menu Links -->
    <div class="hidden md:flex space-x-8">
      {navLinks.map((link) => {
        const isActive = (link.href === '/' && currentPath === '/') || (link.href !== '/' && currentPath === link.href);
        return (
          <a 
            href={link.href}
            class={`font-semibold text-sm tracking-wide relative group transition-colors duration-300 ${isActive ? 'text-[#ff2a2a]' : 'text-white/80 hover:text-white'}`}
          >
            {link.name}
            <span class={`absolute -bottom-1 left-0 h-0.5 bg-[#ff2a2a] transition-all duration-300 ${isActive ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
          </a>
        );
      })}
    </div>

    <!-- Right Side: CTA Button -->
    <div class="hidden md:block">
      <a 
        href={hireMeMailto}
        class="px-6 py-2.5 rounded-full bg-white/10 border border-white/20 text-white font-semibold hover:bg-white/20 hover:shadow-[0_0_15px_rgba(255,255,255,0.2)] transition-all duration-300 backdrop-blur-md"
      >
        Hire Me
      </a>
    </div>

    <!-- Mobile Hamburger Menu Icon -->
    <div class="md:hidden flex items-center">
      <button 
        id="menu-toggle"
        class="text-white focus:outline-none p-2 cursor-pointer"
        aria-label="Toggle Menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Slide-Down Menu -->
  <div 
    id="mobile-menu"
    class="md:hidden absolute top-full left-0 w-full transition-all duration-300 overflow-hidden max-h-0 opacity-0 bg-transparent"
  >
    <div class="flex flex-col px-6 space-y-4 py-6 bg-[#ff2a2a] shadow-2xl">
      {navLinks.map((link) => {
        const isActive = (link.href === '/' && currentPath === '/') || (link.href !== '/' && currentPath === link.href);
        return (
          <a 
            href={link.href}
            class={`font-black text-xl pb-2 border-b border-white/20 transition-colors ${isActive ? 'text-black' : 'text-white hover:text-black'}`}
          >
            {link.name}
          </a>
        );
      })}
      <div class="pt-4 pb-2">
         <a 
           href={hireMeMailto}
           class="inline-block px-6 py-3 rounded-full bg-white text-[#ff2a2a] font-black hover:bg-black hover:text-white transition-colors w-full text-center shadow-lg"
         >
           Hire Me
         </a>
      </div>
    </div>
  </div>
</nav>

<script>
  function setupNavbar() {
    const navbar = document.getElementById('main-navbar');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');

    if (!navbar) return;

    // Handle Scroll for sticky solid background
    const handleScroll = () => {
      if (window.scrollY > 50) {
        navbar.classList.remove('py-6', 'bg-transparent');
        navbar.classList.add('py-4', 'bg-black/95', 'backdrop-blur-md', 'border-b', 'border-white/10');
      } else {
        navbar.classList.remove('py-4', 'bg-black/90', 'backdrop-blur-md', 'border-b', 'border-white/10');
        navbar.classList.add('py-6', 'bg-transparent');
      }
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Trigger initially in case page is loaded scrolled

    // Mobile Menu Toggle
    let isMenuOpen = false;
    if (menuToggle && mobileMenu && hamburgerIcon) {
      // Clean up previous event listener to avoid duplicate bindings
      const newToggle = menuToggle.cloneNode(true);
      menuToggle.parentNode.replaceChild(newToggle, menuToggle);

      newToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        isMenuOpen = !isMenuOpen;
        if (isMenuOpen) {
          // Open menu
          mobileMenu.classList.remove('max-h-0', 'opacity-0', 'bg-transparent');
          mobileMenu.classList.add('max-h-96', 'opacity-100');
          navbar.classList.add('bg-[#ff2a2a]');
          hamburgerIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
        } else {
          // Close menu
          mobileMenu.classList.remove('max-h-96', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          navbar.classList.remove('bg-[#ff2a2a]');
          hamburgerIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          handleScroll();
        }
      });

      // Close menu when clicking links
      const links = mobileMenu.querySelectorAll('a');
      links.forEach(link => {
        link.addEventListener('click', () => {
          isMenuOpen = false;
          mobileMenu.classList.remove('max-h-96', 'opacity-100');
          mobileMenu.classList.add('max-h-0', 'opacity-0');
          navbar.classList.remove('bg-[#ff2a2a]');
          hamburgerIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          handleScroll();
        });
      });
    }
  }

  // Setup on page load
  setupNavbar();

  // Setup on View Transition navigation
  document.addEventListener('astro:after-swap', setupNavbar);
</script>
