---
import { skillsContent } from '../data/portfolioData';
---

<section 
  id="process-container"
  class="bg-white pt-24 pb-32 px-6 md:px-12 w-full relative overflow-hidden font-sans bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:80px_80px]"
>
  <div class="max-w-6xl mx-auto relative md:h-[1350px]">
    
    <!-- Header Content -->
    <div data-aos="fade-up" class="md:absolute top-10 left-0 md:w-[450px] z-20 mb-16 md:mb-0">
      <div class="inline-block border border-gray-300 rounded-full px-5 py-1.5 text-sm text-gray-600 font-bold mb-8 shadow-sm bg-white">
        {skillsContent.badge}
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 leading-[1.1] mb-6 tracking-tight relative">
        {skillsContent.heading}
        <!-- Hand-drawn arrow -->
        <svg class="absolute -bottom-10 right-10 w-12 h-12 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M4 4 Q 10 10 15 15 M 15 15 L 10 15 M 15 15 L 15 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </h2>
      <p class="text-gray-500 text-base md:text-lg max-w-sm font-medium leading-relaxed">
        {skillsContent.description}
      </p>
    </div>

    <!-- Desktop SVG Animated Dashed Line -->
    <svg 
      class="hidden md:block absolute top-0 left-0 w-full h-[1350px] pointer-events-none z-0" 
      viewBox="0 0 1000 1350" 
      preserveAspectRatio="none"
    >
      <!-- Faint background path (guide) -->
      <path 
        d="M 650,200 C 400,300 200,400 300,600 C 400,800 750,750 700,950 C 650,1150 400,1150 300,1200" 
        fill="none" 
        stroke="#cbd5e1" 
        stroke-width="2" 
        stroke-dasharray="8 10" 
      />

      <!-- The actual dashed line that gets revealed on scroll -->
      <path 
        id="process-path"
        d="M 650,200 C 400,300 200,400 300,600 C 400,800 750,750 700,950 C 650,1150 400,1150 300,1200" 
        fill="none" 
        stroke="black" 
        stroke-width="2" 
        stroke-dasharray="8 10" 
        class="drop-shadow-sm transition-all duration-75"
      />
    </svg>

    <!-- Mobile Animated Vertical Dashed Line -->
    <svg 
      class="md:hidden absolute top-0 left-[50%] -translate-x-1/2 w-4 h-[100%] pointer-events-none z-0" 
      viewBox="0 0 4 100" 
      preserveAspectRatio="none"
    >
      <path 
        d="M 2,0 L 2,100" 
        fill="none" 
        stroke="#cbd5e1" 
        stroke-width="4" 
        stroke-dasharray="4 6" 
        vector-effect="non-scaling-stroke"
      />
      <path 
        id="process-path-mobile"
        d="M 2,0 L 2,100" 
        fill="none" 
        stroke="black" 
        stroke-width="4" 
        stroke-dasharray="4 6" 
        vector-effect="non-scaling-stroke"
        class="transition-all duration-75"
      />
    </svg>

    <!-- Cards Container -->
    <div class="flex flex-col gap-8 md:gap-12 items-center md:block relative z-10 w-full pt-4 md:pt-0 pb-12 md:pb-0">
      
      {skillsContent.cards.map((card, index) => {
        const positions = [
          "md:absolute md:top-[10px] md:right-[5%] lg:right-[10%] rotate-2 md:rotate-6",
          "md:absolute md:top-[450px] md:left-[5%] lg:left-[10%] -rotate-2 md:-rotate-6",
          "md:absolute md:top-[700px] md:right-[5%] lg:right-[15%] rotate-1 md:rotate-3",
          "md:absolute md:top-[1050px] md:left-[15%] lg:left-[25%] -rotate-1 md:-rotate-3",
        ];
        const aosTypes = ["fade-left", "fade-right", "fade-left", "fade-right"];
        const aosDelays = ["100", "200", "300", "400"];

        return (
          <div 
            data-aos={aosTypes[index]} 
            data-aos-delay={aosDelays[index]}
            class={`process-card w-72 sm:w-80 rounded-[2rem] p-2 relative flex flex-col items-center hover:scale-[1.02] transition-all duration-700 z-10 bg-white border border-gray-200 shadow-[0_15px_40px_rgba(0,0,0,0.06)] hover:shadow-[0_20px_50px_rgba(0,0,0,0.12)] ${positions[index]}`}
            data-index={index}
          >
            <!-- The hole punch -->
            <div class="w-5 h-5 bg-gradient-to-br from-gray-300 to-gray-100 rounded-full shadow-[inset_0_2px_4px_rgba(0,0,0,0.3)] absolute top-4 border border-gray-300 z-10 flex items-center justify-center">
              <div class="w-2 h-2 bg-gray-800 rounded-full opacity-20"></div>
            </div>
            
            <!-- Inner container -->
            <div class="inner-container w-full h-full rounded-[1.5rem] mt-8 p-8 flex flex-col min-h-[220px] bg-[#f4f4f4] transition-colors duration-700">
              <span class="card-number text-xl font-bold mb-2 font-serif italic text-gray-400 transition-colors duration-700">
                {card.number}
              </span>
              
              <h3 class="card-title text-2xl font-black mb-3 tracking-tight text-gray-900 transition-colors duration-700">
                {card.title}
              </h3>
              
              <p class="card-text text-sm leading-relaxed font-medium text-gray-500 transition-colors duration-700">
                {card.text}
              </p>
            </div>
          </div>
        );
      })}

      <!-- Hand-drawn end text -->
      <div 
        data-aos="fade-in" 
        data-aos-delay="600"
        class="hidden md:block absolute top-[1250px] left-[60%] font-['Caveat',cursive] text-3xl text-gray-600 rotate-6"
      >
        {skillsContent.endText}
      </div>

    </div>

  </div>
</section>

<style>
  /* Custom Active styles for Process timeline cards */
  :global(.process-card.active-card) {
    background-color: #ff2a2a !important;
    border-color: #f87171 !important;
    box-shadow: 0 20px 50px rgba(255, 42, 42, 0.4) !important;
  }
  
  :global(.process-card.active-card .inner-container) {
    background-color: rgba(185, 28, 28, 0.5) !important;
  }
  
  :global(.process-card.active-card .card-number) {
    color: #fca5a5 !important;
  }
  
  :global(.process-card.active-card .card-title) {
    color: #ffffff !important;
  }
  
  :global(.process-card.active-card .card-text) {
    color: #fee2e2 !important;
  }
</style>

<script>
  function setupProcessScroll() {
    const container = document.getElementById('process-container');
    const path = document.getElementById('process-path');
    const pathMobile = document.getElementById('process-path-mobile');
    const cards = document.querySelectorAll('.process-card');

    if (!container) return;

    // Desktop path calculation
    let pathLength = 0;
    if (path) {
      pathLength = path.getTotalLength();
      path.style.strokeDasharray = String(pathLength);
      path.style.strokeDashoffset = String(pathLength);
    }

    // Mobile path calculation
    let pathLengthMobile = 0;
    if (pathMobile) {
      pathLengthMobile = pathMobile.getTotalLength();
      pathMobile.style.strokeDasharray = String(pathLengthMobile);
      pathMobile.style.strokeDashoffset = String(pathLengthMobile);
    }

    const handleScroll = () => {
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // Calculate scroll progress relative to the container
      const startTrigger = rect.top - viewportHeight / 2;
      const totalScrollableHeight = rect.height - viewportHeight / 2;
      
      let progress = 0;
      if (rect.top <= viewportHeight / 2) {
        progress = Math.min(1, Math.max(0, -startTrigger / totalScrollableHeight));
      }

      // Update paths
      if (path) {
        path.style.strokeDashoffset = String(pathLength * (1 - progress));
      }
      if (pathMobile) {
        pathMobile.style.strokeDashoffset = String(pathLengthMobile * (1 - progress));
      }

      // Activate cards based on their position in the viewport
      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        // Activate card when its top edge crosses 65% of the viewport height from the top
        if (cardRect.top < viewportHeight * 0.65) {
          card.classList.add('active-card');
        } else {
          card.classList.remove('active-card');
        }
      });
    };

    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Run initially
  }

  // Initial setup
  setupProcessScroll();

  // Re-run on route changes for View Transitions
  document.addEventListener('astro:after-swap', setupProcessScroll);
</script>
